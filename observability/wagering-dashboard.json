{
  "uid": "wagering-overview",
  "title": "Wagering Processor",
  "description": "Operational metrics for the local challenge. Counters reset on process restart; outbox gauges describe the shared database. Explore the Wagering traces datasource to inspect traces.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "wagering"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Transactions by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(wagering_transactions_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Processing latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(wagering_processing_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wagering_processing_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wagering_processing_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Duplicate deliveries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(wagering_duplicates_total[$__rate_interval]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "title": "Retries by source",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(wagering_retries_total[$__rate_interval]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Dead-lettered messages",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(wagering_dlq_total[$__range]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "title": "Lock conflicts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
