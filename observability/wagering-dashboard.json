    },
    {
      "id": 10,
      "title": "Available application instances",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
