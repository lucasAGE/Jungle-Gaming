          "refId": "A",
          "expr": "sum(increase(wagering_lock_conflicts_total[$__range]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "title": "Outbox pending events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(wagering_outbox_pending)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "title": "Oldest pending event",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
