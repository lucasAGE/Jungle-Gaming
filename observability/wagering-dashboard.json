          "legendFormat": ""
        }
      ]
    },
    {
      "id": 9,
      "title": "Reconciliation divergences",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wagering-prometheus"
      },
      "gridPos": {
        "h": 8,
